; Godot project configuration for the Flame Emblem playable foundation.
; This file keeps the first prototype lightweight and uses the compatibility renderer.
config_version=5

[application]
config/name="Flame Emblem"
run/main_scene="res://scenes/title/TitleScreen.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="FlameEmblem"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)
