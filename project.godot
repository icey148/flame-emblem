; Godot project configuration for the Flame Emblem playable foundation.
; The visual baseline is 1280x720. The scene is rendered into that fixed viewport
; first and only then enlarged by integer multiples, preventing fractional pixel sampling.
config_version=5

[application]
config/name="Flame Emblem"
run/main_scene="res://scenes/title/TitleScreen.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[dotnet]
project/assembly_name="FlameEmblem"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)
