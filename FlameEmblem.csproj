<Project Sdk="Godot.NET.Sdk/4.7.1">
  <!--
    Flame Emblem uses Godot's .NET SDK so gameplay can be written in C#.
    The project currently targets the latest stable Godot 4.7.1 .NET release.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
