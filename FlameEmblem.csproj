<Project Sdk="Godot.NET.Sdk/4.6.1">
  <!--
    Flame Emblem uses Godot's .NET SDK so gameplay can be written in C#.
    .NET 8 is the baseline for desktop development in the current Godot 4.x line.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
